// by Nisan and Schocken, MIT Press.
// File name: projects/09/Square/Square.jack
//
// ADAPTADO:
//  - Posicao agora em CELULAS (col, row) e nao em pixels (x, y). Cada passo
//    anda exatamente uma celula de 16x16.
//  - Novo campo "direction" (0=parado, 1=cima, 2=baixo, 3=esquerda,
//    4=direita) e metodos setDirection, stop e step(Maze): o movimento fica
//    "travado" na direcao ate bater numa parede ou o jogador mandar parar.
//    (No original a direcao ficava no GhostGame.)
//  - moveUp/moveDown/moveLeft/moveRight agora perguntam ao Maze se a proxima
//    celula e parede, em vez de testar limites de pixels da tela.
//  - erase() usava Screen.drawRectangle(x, y, x + size, y + size), que apaga
//    17x17 pixels (os dois extremos entram) e borrava a celula vizinha.
//    Agora apaga exatamente 16 linhas com 16 Memory.poke(..., 0).
//  - Removidos incSize/decSize e o campo size (o tamanho e sempre 16).
//  - Mantido o desenho original do fantasma feliz (drawHappyGhost).
//  - O construtor nao recebe posicao nem desenha: o objeto e criado uma
//    vez so e cada rodada chama reset(col, row). Assim nada e alocado por
//    rodada (evita a fragmentacao do heap; ver ESTUDO.md).

/**
 * Ghost: o personagem do Jogador 1 (setas).
 * Guarda sua posicao (col, row) e sua direcao atual, anda uma celula por
 * vez e se desenha direto na memoria de video.
 */
class Ghost {

   field int col, row;     // celula atual (coluna 0..31, linha 1..15)
   field int direction;    // 0=parado, 1=cima, 2=baixo, 3=esquerda, 4=direita
   field int memAddress;   // endereco usado no desenho

   /**
    * Cria o fantasma (uma vez por jogo). Nao desenha nada: a posicao de
    * verdade vem de reset(), chamado no inicio de cada rodada.
    */
   constructor Ghost new() {
      let col = 1;
      let row = 1;
      let direction = 0;
      let memAddress = 0;
      return this;
   }

   /**
    * Recoloca o fantasma na celula (Acol, Arow), parado, e desenha.
    * Chamado no inicio de cada rodada: o objeto e criado uma vez so e
    * reaproveitado (nada e alocado por rodada).
    */
   method void reset(int Acol, int Arow) {
      let col = Acol;
      let row = Arow;
      let direction = 0;
      do draw();
      return;
   }

   /** Libera a memoria do objeto (so no fim do jogo). */
   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   method int getCol() { return col; }
   method int getRow() { return row; }

   /** Define a direcao (fica valendo ate bater numa parede). */
   method void setDirection(int d) {
      let direction = d;
      return;
   }

   /** Para o movimento. */
   method void stop() {
      let direction = 0;
      return;
   }

   /** Anda uma celula na direcao atual (se estiver se movendo). */
   method void step(Maze maze) {
      if (direction = 1) { do moveUp(maze); }
      if (direction = 2) { do moveDown(maze); }
      if (direction = 3) { do moveLeft(maze); }
      if (direction = 4) { do moveRight(maze); }
      return;
   }

   /** Sobe uma celula; se for parede, para. */
   method void moveUp(Maze maze) {
      if (maze.isWall(col, row - 1)) {
         let direction = 0;
      } else {
         do moveTo(col, row - 1);
      }
      return;
   }

   /** Desce uma celula; se for parede, para. */
   method void moveDown(Maze maze) {
      if (maze.isWall(col, row + 1)) {
         let direction = 0;
      } else {
         do moveTo(col, row + 1);
      }
      return;
   }

   /** Vai uma celula para a esquerda; se for parede, para. */
   method void moveLeft(Maze maze) {
      if (maze.isWall(col - 1, row)) {
         let direction = 0;
      } else {
         do moveTo(col - 1, row);
      }
      return;
   }

   /** Vai uma celula para a direita; se for parede, para. */
   method void moveRight(Maze maze) {
      if (maze.isWall(col + 1, row)) {
         let direction = 0;
      } else {
         do moveTo(col + 1, row);
      }
      return;
   }

   /** Apaga na posicao antiga, muda a posicao e desenha na nova. */
   method void moveTo(int newCol, int newRow) {
      do erase();
      let col = newCol;
      let row = newRow;
      do draw();
      return;
   }

   /** Desenha o fantasma. Endereco da celula: (row * 512) + col. */
   method void draw() {
      do drawHappyGhost((row * 512) + col);
      return;
   }

   /** Apaga exatamente as 16 linhas da celula. */
   method void erase() {
      var int address, line;
      let address = 16384 + (row * 512) + col;
      let line = 0;
      while (line < 16) {
         do Memory.poke(address, 0);
         let address = address + 32;   // proxima linha de pixels
         let line = line + 1;
      }
      return;
   }

   /** Desenho original: 16 palavras de 16 bits (bit 0 = pixel da esquerda). */
   method void drawHappyGhost(int location) {
      let memAddress = 16384+location;
      do Memory.poke(memAddress+0, 8184);
      do Memory.poke(memAddress+32, 16380);
      do Memory.poke(memAddress+64, 25542);
      do Memory.poke(memAddress+96, -1);
      do Memory.poke(memAddress+128, -2065);
      do Memory.poke(memAddress+160, -7225);
      do Memory.poke(memAddress+192, -7225);
      do Memory.poke(memAddress+224, -2065);
      do Memory.poke(memAddress+256, -1);
      do Memory.poke(memAddress+288, -1);
      do Memory.poke(memAddress+320, -1);
      do Memory.poke(memAddress+352, -4081);
      do Memory.poke(memAddress+384, -2017);
      do Memory.poke(memAddress+416, -961);
      do Memory.poke(memAddress+448, -1);
      do Memory.poke(memAddress+480, -1);
      return;
   }
}
