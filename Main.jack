/**
 * Ponto de entrada do programa.
 * Cria o jogo (GhostGame), roda o jogo ate o jogador apertar Esc
 * e depois libera a memoria.
 */
class Main {
    function void main() {
        var GhostGame game;
        let game = GhostGame.new();
        do game.run();
        do game.dispose();
        return;
    }
}
